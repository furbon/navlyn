<Project>
  <PropertyGroup>
    <Version>0.8.7</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(Version.Split('-')[0]).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageReleaseNotes>$(Version) reaps canceled MCP process trees, bounds wrapper output, replaces redundant validation with a fast .NET 10 product suite and portable smoke, pins Actions, and measures repeated warm MCP calls.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
