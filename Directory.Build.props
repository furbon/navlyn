<Project>
  <PropertyGroup>
    <Version>0.8.5</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(Version.Split('-')[0]).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageReleaseNotes>$(Version) accepts natural symbol kind names and reuses validated release artifacts across publication and tag checks.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
