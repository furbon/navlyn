<Project>
  <PropertyGroup>
    <Version>0.9.2</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(Version.Split('-')[0]).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageReleaseNotes>0.9.2 applies MCP outline bounds before fact and JSON construction, clarifies direct bound-DLL reading and on-demand CLI integration, adds opt-in MCP stage diagnostics and a reproducible unforced adoption comparison, and checks paging and diagnostics on every CI platform.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
