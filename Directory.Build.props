<Project>
  <PropertyGroup>
    <Version>0.9.1</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(Version.Split('-')[0]).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageReleaseNotes>0.9.1 adds a focused four-tool MCP surface, compact paged responses with per-call full detail, qualified symbol queries and independent type-kind filtering, smaller hybrid routing guidance, recent-release skill upgrades, and shorter bounded publication indexing waits.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
