<Project>
  <PropertyGroup>
    <Version>0.8.6</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(Version.Split('-')[0]).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageReleaseNotes>$(Version) enforces MCP deadlines, preserves workflow reproduction inputs and historical version records, and adds CI diagnostics and publication recovery summaries.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
