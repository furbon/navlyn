<Project>
  <PropertyGroup>
    <Version>0.9.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <AssemblyVersion>$(Version.Split('-')[0]).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageReleaseNotes>$(Version) requires .NET 10, reuses warm MCP workspaces for target/navigation, adds explicit target-framework selection, upgrades MCP SDK 2.0, compacts schemas/results, and removes generated artifacts from repository summaries.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
